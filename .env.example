# Copia este archivo a .env y completa los valores

# next-auth. Genera un secreto con: openssl rand -hex 32
# En Vercel no hace falta NEXTAUTH_URL (se detecta solo)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# PostgreSQL (p. ej. Neon: https://neon.tech)
# DATABASE_URL: conexión con pool (host con "-pooler"), la usa la app
# DATABASE_URL_UNPOOLED: conexión directa, la usan las migraciones (en local puede ser la misma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Solo para `npm run db:seed`: crea/actualiza el usuario administrador
ADMIN_EMAIL=jagredo03@gmail.com
ADMIN_PASSWORD=
